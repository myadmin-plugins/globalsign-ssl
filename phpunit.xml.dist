<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/9.6/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheResultFile=".phpunit.cache/test-results"
         colors="true"
         verbose="true"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="false"
>
    <testsuites>
        <testsuite name="unit">
            <directory>tests/unit</directory>
            <!--
                Named explicitly rather than by widening the directory to `tests`.
                tests/GlobalSignTest.php also sits at that level and declares
                `setUp()` without the `: void` return type PHPUnit 9 requires, so it
                fatals on load and takes the whole run with it, which is why this
                suite was narrowed to tests/unit in the first place. Widening the
                directory would silently re-break the build.
            -->
            <file>tests/ContractTest.php</file>
        </testsuite>
    </testsuites>

    <coverage cacheDirectory=".phpunit.cache/code-coverage"
              processUncoveredFiles="true">
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </coverage>
</phpunit>
